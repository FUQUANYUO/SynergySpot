prefix=D:/WORKLib/grpc/install
exec_prefix=${prefix}
libdir=D:/WORKLib/grpc/install/lib
includedir=D:/WORKLib/grpc/install/include

Name: absl_flags_config
Description: Abseil flags_config library
URL: https://abseil.io/
Version: 20211102
Requires: absl_config = 20211102, absl_flags_path_util = 20211102, absl_flags_program_name = 20211102, absl_core_headers = 20211102, absl_strings = 20211102, absl_synchronization = 20211102
Libs: -L${libdir} -ignore:4221 -labsl_flags_config
Cflags: -I${includedir} /W3 /DNOMINMAX /DWIN32_LEAN_AND_MEAN /D_CRT_SECURE_NO_WARNINGS /D_SCL_SECURE_NO_WARNINGS /D_ENABLE_EXTENDED_ALIGNED_STORAGE /bigobj /wd4005 /wd4068 /wd4180 /wd4244 /wd4267 /wd4503 /wd4800
