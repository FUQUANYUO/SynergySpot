prefix=D:/WORKLib/grpc/install
exec_prefix=${prefix}
libdir=D:/WORKLib/grpc/install/lib
includedir=D:/WORKLib/grpc/install/include

Name: absl_random_bit_gen_ref
Description: Abseil random_bit_gen_ref library
URL: https://abseil.io/
Version: 20211102
Requires: absl_core_headers = 20211102, absl_random_internal_distribution_caller = 20211102, absl_random_internal_fast_uniform_bits = 20211102, absl_type_traits = 20211102
Libs: -L${libdir} -ignore:4221 
Cflags: -I${includedir} /W3 /DNOMINMAX /DWIN32_LEAN_AND_MEAN /D_CRT_SECURE_NO_WARNINGS /D_SCL_SECURE_NO_WARNINGS /D_ENABLE_EXTENDED_ALIGNED_STORAGE /bigobj /wd4005 /wd4068 /wd4180 /wd4244 /wd4267 /wd4503 /wd4800
