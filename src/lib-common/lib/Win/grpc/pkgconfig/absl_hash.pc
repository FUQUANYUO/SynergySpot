prefix=D:/WORKLib/grpc/install
exec_prefix=${prefix}
libdir=D:/WORKLib/grpc/install/lib
includedir=D:/WORKLib/grpc/install/include

Name: absl_hash
Description: Abseil hash library
URL: https://abseil.io/
Version: 20211102
Requires: absl_city = 20211102, absl_config = 20211102, absl_core_headers = 20211102, absl_endian = 20211102, absl_fixed_array = 20211102, absl_meta = 20211102, absl_int128 = 20211102, absl_strings = 20211102, absl_optional = 20211102, absl_variant = 20211102, absl_utility = 20211102, absl_low_level_hash = 20211102
Libs: -L${libdir}  -labsl_hash
Cflags: -I${includedir} /W3 /DNOMINMAX /DWIN32_LEAN_AND_MEAN /D_CRT_SECURE_NO_WARNINGS /D_SCL_SECURE_NO_WARNINGS /D_ENABLE_EXTENDED_ALIGNED_STORAGE /bigobj /wd4005 /wd4068 /wd4180 /wd4244 /wd4267 /wd4503 /wd4800
